<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SmFormats\SmFormats.csproj" />
    <ProjectReference Include="..\SmContent\SmContent.csproj" />
    <!-- T1 (Phase B): the Classic bot brain, engine-free. -->
    <ProjectReference Include="..\SmBots\SmBots.csproj" />
    <!-- release-parts: the parts manifest, builder and upload plan the launcher reads (one implementation for both sides). -->
    <ProjectReference Include="..\SmLauncher.Core\SmLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SmExtras)' == 'true'">
    <!-- Added content: the Mapmaker core (docs/mapmaker.md), behind `smtool map`. -->
    <ProjectReference Include="..\SmMapmaker\SmMapmaker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client's procedural melee hit sounds (pure C#, no Godot): rendered as the "now" previews; the client is not changed. -->
    <Compile Include="..\..\client\ImpactRules\MeleeHitSynth.cs" Link="ClientImpactRules\MeleeHitSynth.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
