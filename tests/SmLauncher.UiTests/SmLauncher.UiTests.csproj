<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher window's layout and repaint checks (LauncherLayoutTests: off-screen windows at -4000,-4000, never activated, nothing on the desktop).
       Windows only; the launcher's logic tests stay in SmLauncher.Tests (plain net10.0). A quick loop leaves them out with the test filter Category!=Window. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmLauncher\SmLauncher.csproj" />
  </ItemGroup>

</Project>
