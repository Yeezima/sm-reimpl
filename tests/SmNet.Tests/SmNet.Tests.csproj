<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The networked view's engine-free look rules (customizer T7; the client's Godot code cannot be referenced from a test project). -->
    <Compile Include="..\..\client\Looks\*.cs" Link="ClientLooks\%(Filename)%(Extension)" />
    <!-- feel/bullets: the visible bullets' engine-free path rules. -->
    <Compile Include="..\..\client\Bullets\*.cs" Link="ClientBullets\%(Filename)%(Extension)" />
    <!-- fx/impact-pass: the impact pass's engine-free rules (look choice, trail path, sword flare, the melee hit gate). -->
    <Compile Include="..\..\client\ImpactRules\*.cs" Link="ClientImpactRules\%(Filename)%(Extension)" />
    <!-- gamepad: the controller binding table, stick curves and device-switch rule, engine-free (PadHost, the Godot side, is not linked). -->
    <Compile Include="..\..\client\Gamepad\GamepadRules.cs" Link="ClientGamepad\GamepadRules.cs" />
    <!-- ui/keybinds: the key and controller bindings store (defaults, conflicts, saving, sampling), engine-free (ControlsInput and ControlsView, the Godot side, are not linked). -->
    <Compile Include="..\..\client\Controls\ControlBindings.cs" Link="ClientControls\ControlBindings.cs" />
    <!-- fix/manufactorum-salmon-2: the names MapDecor does not draw on Manufactorum, engine-free. -->
    <!-- Warfront W10: the squad view's engine-free model (the Godot side is not linked); dropped with Extras/Warfront by -p:SmWarfront=false. -->
    <Compile Include="..\..\client\Extras\Warfront\Squad\WarfrontSquadModel.cs" Link="ClientWarfrontSquad\WarfrontSquadModel.cs" Condition="'$(SmExtras)' == 'true' and '$(SmWarfront)' == 'true'" />
  </ItemGroup>
  <!-- Warfront: the card picker's Godot-free model (client/Extras/Warfront/Progression) gets xUnit tests here. -->
  <ItemGroup Condition="'$(SmExtras)' == 'true' and '$(SmWarfront)' == 'true'">
    <Compile Include="..\..\client\Extras\Warfront\Progression\WarfrontProgressModel.cs" Link="ClientWarfront\WarfrontProgressModel.cs" />
    <Compile Include="..\..\client\Extras\Warfront\WarfrontSquadClassOption.cs" Link="ClientWarfront\WarfrontSquadClassOption.cs" />   <!-- W5c: the row action stores the option -->
  </ItemGroup>

  <ItemGroup Condition="'$(SmExtras)' == 'true' and '$(SmWarfront)' == 'true'">
    <!-- Warfront W5b: the client's stage flow without Godot (the hub's view and model, the stage model, the key file), tested here. -->
    <Compile Include="..\..\client\Extras\Warfront\Hub\WarfrontHubView.cs" Link="ClientWarfront\WarfrontHubView.cs" />
    <Compile Include="..\..\client\Extras\Warfront\Hub\WarfrontHubModel.cs" Link="ClientWarfront\WarfrontHubModel.cs" />
    <Compile Include="..\..\client\Extras\Warfront\Stage\WarfrontStageModel.cs" Link="ClientWarfront\WarfrontStageModel.cs" />
    <Compile Include="..\..\client\Extras\Warfront\Stage\WarfrontClientKey.cs" Link="ClientWarfront\WarfrontClientKey.cs" />
    <!-- Warfront dressing part 1: the engine-free plans (kit table, fortress pieces, far massing), tested here. -->
    <Compile Include="..\..\client\Extras\Warfront\Maps\Dress\WarfrontDressModel.cs" Link="ClientWarfront\WarfrontDressModel.cs" />
    <Compile Include="..\..\client\Extras\Warfront\Maps\Dress\WarfrontFortressDressPlan.cs" Link="ClientWarfront\WarfrontFortressDressPlan.cs" />
    <Compile Include="..\..\client\Extras\Warfront\Maps\Dress\WarfrontHqDressPlan.cs" Link="ClientWarfront\WarfrontHqDressPlan.cs" />
    <Compile Include="..\..\client\Extras\Warfront\Maps\Dress\WarfrontFarMassingPlan.cs" Link="ClientWarfront\WarfrontFarMassingPlan.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SmExtras)' == 'true'">
    <!-- Weather W1: the client's Godot-free weather model and look (and the lighting grade type they build on), tested here. -->
    <Compile Include="..\..\client\Customizer\Model\LightingPresets.cs" Link="ClientWeather\LightingPresets.cs" />
    <Compile Include="..\..\client\Extras\Weather\WeatherGrade.cs" Link="ClientWeather\WeatherGrade.cs" />
    <Compile Include="..\..\client\Extras\Weather\WeatherClientModel.cs" Link="ClientWeather\WeatherClientModel.cs" />
    <Compile Include="..\..\client\Extras\Weather\WeatherSettings.cs" Link="ClientWeather\WeatherSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmServer\SmServer.csproj" />
    <ProjectReference Include="..\..\src\SmNet\SmNet.csproj" />
    <ProjectReference Include="..\..\src\SmSim\SmSim.csproj" />
    <ProjectReference Include="..\..\src\SmContent\SmContent.csproj" />
  </ItemGroup>

</Project>
